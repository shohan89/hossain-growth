# Copy this file to .dev.vars and fill in real values for local development.
# .dev.vars is gitignored and is read automatically by `wrangler dev`.
# Never commit real secrets.

# Cloudflare Turnstile (test keys — see https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Session cookie signing key (generate with: openssl rand -base64 32)
SESSION_SIGNING_KEY=replace-with-a-real-random-base64-secret

# Lead notification email (optional — provider defaults to "none", which
# only logs instead of sending; a missing/failed send never blocks lead
# creation). Only "resend" is implemented today — see src/lib/email.ts.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=no-reply@yourdomain.com
NOTIFICATION_EMAIL_TO=team@yourdomain.com
