{
  "name": "hossain-growth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "cf:build": "astro build",
    "cf:typegen": "wrangler types",
    "check": "astro check",
    "deploy:staging": "astro build && wrangler deploy --config dist/server/wrangler.json --env staging",
    "deploy:production": "astro build && wrangler deploy --config dist/server/wrangler.json --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hossain-growth-dev --local --persist-to .wrangler/state",
    "db:migrate:dev:remote": "wrangler d1 migrations apply hossain-growth-dev --remote",
    "db:migrate:staging": "wrangler d1 migrations apply hossain-growth-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply hossain-growth-production --remote --env production",
    "db:seed:local": "wrangler d1 execute hossain-growth-dev --local --persist-to .wrangler/state --file=seeds/dev-seed.sql",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "jose": "^6.1.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bufferutil": "^4.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "utf-8-validate": "^6.1.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
