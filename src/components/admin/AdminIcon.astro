---
import { ADMIN_ICON_PATHS, type AdminIconName } from '../../lib/admin/icons';

interface Props {
  name: AdminIconName;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={ADMIN_ICON_PATHS[name]} />
</svg>
