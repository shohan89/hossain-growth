---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

interface CaseStudyRow {
  slug: string;
  title: string;
  client: string | null;
  industry: string | null;
  results: string | null;
}

interface Props {
  caseStudies: CaseStudyRow[];
}

const { caseStudies } = Astro.props;
---

{caseStudies.length > 0 && (
  <section class="bg-bone-100 py-24 lg:py-32">
    <Container class="flex flex-col gap-12">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading
          eyebrow="Case studies"
          title="Real results, told in full"
          class="sm:max-w-xl"
        />
        <Button href="/case-studies" variant="outline">
          Read all case studies
        </Button>
      </div>

      <div class="grid gap-5 lg:grid-cols-2">
        {caseStudies.map((study) => (
          <a
            href={`/case-studies/${study.slug}`}
            class="flex flex-col gap-4 rounded-3xl border border-ink-900/8 bg-bone-50 p-8 transition-colors hover:border-lime-500/60"
          >
            <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-ink-500">
              {study.industry && <span>{study.industry}</span>}
              {study.client && <span>&middot; {study.client}</span>}
            </div>
            <h3 class="font-display text-xl font-semibold text-ink-900">{study.title}</h3>
            {study.results && <p class="text-sm text-ink-600">{study.results}</p>}
            <span class="mt-auto text-sm font-semibold text-ink-900">Read the full story →</span>
          </a>
        ))}
      </div>
    </Container>
  </section>
)}
