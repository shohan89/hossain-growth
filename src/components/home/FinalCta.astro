---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ready to build your next stage of growth?',
  description = 'Book a free consultation and leave with a clear view of where your growth strategy stands today.',
} = Astro.props;
---

<section class="bg-ink-950 py-24 text-bone-50 lg:py-28">
  <Container class="flex flex-col items-center gap-6 text-center">
    <h2 class="max-w-2xl font-display text-3xl font-bold sm:text-4xl lg:text-5xl">{title}</h2>
    <p class="max-w-xl text-lg text-ink-200">{description}</p>
    <Button href="/contact?intent=consultation" variant="primary" size="lg">
      Book a Free Consultation
    </Button>
  </Container>
</section>
