---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden bg-ink-950 text-bone-50">
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(60% 50% at 80% 0%, rgba(214,255,63,0.16), transparent), radial-gradient(40% 40% at 10% 100%, rgba(214,255,63,0.08), transparent);"
    aria-hidden="true"
  ></div>

  <Container class="relative flex flex-col gap-10 py-24 lg:py-32">
    <span class="animate-fade-up inline-flex w-fit items-center gap-2 rounded-full border border-bone-50/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-lime-400">
      Your Business Growth Partner
    </span>

    <h1 class="animate-fade-up max-w-4xl text-4xl font-bold leading-[1.05] sm:text-6xl lg:text-7xl">
      We don't just market your business. We help you
      <span class="text-lime-400">build, grow, and scale it</span>.
    </h1>

    <p class="animate-fade-up max-w-2xl text-lg text-ink-200 sm:text-xl">
      Hossain Growth combines strategic digital marketing and modern technology into one growth
      engine — so every campaign, page, and channel works toward the same outcome: your business
      scaling.
    </p>

    <div class="animate-fade-up flex flex-col gap-4 sm:flex-row">
      <Button href="/contact?intent=consultation" variant="primary" size="lg">
        Book a Free Consultation
      </Button>
      <Button
        href="/portfolio"
        variant="outline"
        size="lg"
        class="border-bone-50/20 text-bone-50 hover:border-bone-50/50"
      >
        Explore Our Work
      </Button>
    </div>
  </Container>
</section>
