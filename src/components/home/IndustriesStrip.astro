---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { INDUSTRIES } from '../../content/industries';

const featured = INDUSTRIES.slice(0, 6);
---

<section class="bg-bone-100 py-24 lg:py-32">
  <Container class="flex flex-col gap-12">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading
        eyebrow="Industries"
        title="Experience across the industries that matter"
        class="sm:max-w-xl"
      />
      <Button href="/industries" variant="outline">
        See all industries
      </Button>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((industry) => (
        <div class="rounded-2xl border border-ink-900/8 bg-bone-50 p-6">
          <h3 class="font-display text-base font-semibold text-ink-900">{industry.name}</h3>
          <p class="mt-2 text-sm text-ink-600">{industry.description}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
