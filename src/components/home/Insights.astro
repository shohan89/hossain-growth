---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

interface PostRow {
  slug: string;
  title: string;
  excerpt: string | null;
  categoryName: string | null;
}

interface Props {
  posts: PostRow[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="bg-bone-100 py-24 lg:py-32">
    <Container class="flex flex-col gap-12">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <SectionHeading eyebrow="Insights" title="Latest from the blog" class="sm:max-w-xl" />
        <Button href="/blog" variant="outline">
          Visit the blog
        </Button>
      </div>

      <div class="grid gap-5 lg:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="flex flex-col gap-3 rounded-3xl border border-ink-900/8 bg-bone-50 p-8 transition-colors hover:border-lime-500/60"
          >
            {post.categoryName && (
              <span class="text-xs font-semibold uppercase tracking-wide text-lime-600">
                {post.categoryName}
              </span>
            )}
            <h3 class="font-display text-lg font-semibold text-ink-900">{post.title}</h3>
            <p class="text-sm text-ink-600">{post.excerpt}</p>
            <span class="mt-auto text-sm font-semibold text-ink-900">Read article →</span>
          </a>
        ))}
      </div>
    </Container>
  </section>
)}
