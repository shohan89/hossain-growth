---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { SERVICE_ICON } from '../../content/services-detail';

interface ServiceRow {
  slug: string;
  title: string;
  summary: string | null;
}

interface Props {
  services: ServiceRow[];
}

const { services } = Astro.props;
---

<section class="py-24 lg:py-32">
  <Container class="flex flex-col gap-12">
    <SectionHeading
      eyebrow="What we do"
      title="Services built to work together"
      description="Six disciplines, one strategy. Combine them, or start with the one your business needs most."
    />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => (
        <a
          href={`/services/${service.slug}`}
          class={`group flex flex-col justify-between gap-5 rounded-3xl border border-ink-900/8 bg-bone-100 p-8 transition-colors hover:border-lime-500/60 hover:bg-bone-50 ${
            index === 0 ? 'sm:col-span-2 lg:col-span-2' : ''
          }`}
        >
          <div class="flex items-center justify-between">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-ink-900 text-lime-400">
              <Icon name={SERVICE_ICON[service.slug] ?? 'layers'} />
            </span>
            <span
              class="text-ink-400 transition-transform group-hover:translate-x-1 group-hover:text-ink-900"
              aria-hidden="true"
            >
              →
            </span>
          </div>
          <div class="flex flex-col gap-2">
            <h3 class="font-display text-xl font-semibold text-ink-900">{service.title}</h3>
            <p class="text-sm text-ink-600">{service.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
