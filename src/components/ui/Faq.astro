---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<div class={`divide-y divide-ink-900/10 ${className}`}>
  {items.map((item) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink-900">
        {item.question}
        <span
          class="shrink-0 text-xl text-ink-400 transition-transform duration-200 group-open:rotate-45"
          aria-hidden="true"
        >
          +
        </span>
      </summary>
      <p class="mt-3 text-ink-600">{item.answer}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
