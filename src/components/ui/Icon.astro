---
export type IconName =
  | 'layers'
  | 'target'
  | 'megaphone'
  | 'search'
  | 'share'
  | 'code'
  | 'chart'
  | 'shield'
  | 'spark'
  | 'rocket'
  | 'users'
  | 'compass';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

const paths: Record<IconName, string> = {
  layers: 'M12 3 2 8l10 5 10-5-10-5ZM2 13l10 5 10-5M2 18l10 5 10-5',
  target: 'M12 12m-9 0a9 9 0 1 0 18 0 9 9 0 1 0-18 0ZM12 12m-4 0a4 4 0 1 0 8 0 4 4 0 1 0-8 0Z',
  megaphone: 'M3 10v4h4l6 4V6l-6 4H3ZM17 8a5 5 0 0 1 0 8',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14ZM21 21l-4.3-4.3',
  share:
    'M18 8a3 3 0 1 0-2.8-4M6 12a3 3 0 1 0 0 0ZM18 20a3 3 0 1 0-2.8-4M8.6 10.6l6.8-3.8M8.6 13.4l6.8 3.8',
  code: 'M9 7 4 12l5 5M15 7l5 5-5 5',
  chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  shield: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3Z',
  spark: 'M12 2v6M12 16v6M2 12h6M16 12h6M5 5l4 4M15 15l4 4M5 19l4-4M15 9l4-4',
  rocket: 'M12 2c3 2 5 6 5 10l-5 10-5-10c0-4 2-8 5-10ZM8 15l-4 4M16 15l4 4',
  users:
    'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20c0-3 2.5-5 6-5s6 2 6 5M17 11a3 3 0 1 0 0-6M15 15c2.8 0 7 1.5 7 5',
  compass: 'M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20ZM15 9l-2 5-5 2 2-5 5-2Z',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
