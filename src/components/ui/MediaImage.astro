---
import type { PublicMediaAsset } from '../../lib/content/public';

interface Props {
  asset: PublicMediaAsset | null | undefined;
  alt: string;
  class?: string;
  /** Rendered instead of the image when there's no asset — defaults to
   * the site's existing gradient placeholder treatment. */
  fallbackClass?: string;
  loading?: 'lazy' | 'eager';
}

const {
  asset,
  alt,
  class: className = '',
  fallbackClass = 'bg-gradient-to-br from-ink-900 to-ink-700',
  loading = 'lazy',
} = Astro.props;

const isRenderableImage = asset && asset.mimeType.startsWith('image/');
---

{isRenderableImage ? (
  <img
    src={`/media/${asset.id}`}
    alt={asset.altText || alt}
    width={asset.width ?? undefined}
    height={asset.height ?? undefined}
    loading={loading}
    decoding="async"
    class={`object-cover ${className}`}
  />
) : (
  <div class={`${fallbackClass} ${className}`} aria-hidden="true" />
)}
