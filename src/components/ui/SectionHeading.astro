---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'left',
  tone = 'light',
  class: className = '',
} = Astro.props;

const alignClass = align === 'center' ? 'items-center text-center' : 'items-start text-left';
const titleColor = tone === 'dark' ? 'text-bone-50' : 'text-ink-900';
const descColor = tone === 'dark' ? 'text-bone-200' : 'text-ink-600';
---

<div class={`flex max-w-3xl flex-col gap-4 ${alignClass} ${className}`}>
  {eyebrow && (
    <span class="text-sm font-semibold uppercase tracking-[0.18em] text-lime-600">{eyebrow}</span>
  )}
  <h2 class={`text-3xl font-bold sm:text-4xl lg:text-5xl ${titleColor}`}>{title}</h2>
  {description && <p class={`text-lg ${descColor}`}>{description}</p>}
</div>
