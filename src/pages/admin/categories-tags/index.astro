---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CategoriesTagsManager from '../../../components/admin/modules/CategoriesTagsManager.tsx';
import { PERMISSIONS } from '../../../lib/auth/permissions';
import { hasPermission } from '../../../lib/auth/rbac';

const session = Astro.locals.session!;
if (!hasPermission(session, PERMISSIONS.BLOG_READ)) return Astro.redirect('/admin');
const canWrite = hasPermission(session, PERMISSIONS.BLOG_WRITE);
const canDelete = hasPermission(session, PERMISSIONS.BLOG_DELETE);
---

<AdminLayout title="Categories & Tags">
  <CategoriesTagsManager client:load canWrite={canWrite} canDelete={canDelete} />
</AdminLayout>
