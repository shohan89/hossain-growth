---
import { env } from 'cloudflare:workers';
import PublicLayout from '../../layouts/PublicLayout.astro';
import ForgotPasswordForm from '../../components/ForgotPasswordForm.tsx';
---

<PublicLayout title="Forgot Password">
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6">
    <h1 class="text-2xl font-bold">Reset your password</h1>
    <ForgotPasswordForm client:load turnstileSiteKey={env.TURNSTILE_SITE_KEY} />
  </main>
</PublicLayout>
