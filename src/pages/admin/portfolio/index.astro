---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PortfolioManager from '../../../components/admin/modules/PortfolioManager.tsx';
import { PERMISSIONS } from '../../../lib/auth/permissions';
import { hasPermission } from '../../../lib/auth/rbac';

const session = Astro.locals.session!;
if (!hasPermission(session, PERMISSIONS.PORTFOLIO_READ)) return Astro.redirect('/admin');
const canWrite = hasPermission(session, PERMISSIONS.PORTFOLIO_WRITE);
const canDelete = hasPermission(session, PERMISSIONS.PORTFOLIO_DELETE);
---

<AdminLayout title="Portfolio">
  <PortfolioManager client:load canWrite={canWrite} canDelete={canDelete} />
</AdminLayout>
