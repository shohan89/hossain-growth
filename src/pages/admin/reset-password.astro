---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ResetPasswordForm from '../../components/ResetPasswordForm.tsx';

const token = Astro.url.searchParams.get('token') ?? '';
---

<PublicLayout title="Reset Password">
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6">
    <h1 class="text-2xl font-bold">Choose a new password</h1>
    {token ? (
      <ResetPasswordForm client:load token={token} />
    ) : (
      <p class="text-sm text-red-600">Missing or invalid reset link.</p>
    )}
  </main>
</PublicLayout>
