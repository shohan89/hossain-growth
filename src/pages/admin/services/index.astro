---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ServicesManager from '../../../components/admin/modules/ServicesManager.tsx';
import { PERMISSIONS } from '../../../lib/auth/permissions';
import { hasPermission } from '../../../lib/auth/rbac';

const session = Astro.locals.session!;
if (!hasPermission(session, PERMISSIONS.SERVICES_READ)) return Astro.redirect('/admin');
const canWrite = hasPermission(session, PERMISSIONS.SERVICES_WRITE);
const canDelete = hasPermission(session, PERMISSIONS.SERVICES_DELETE);
---

<AdminLayout title="Services">
  <ServicesManager client:load canWrite={canWrite} canDelete={canDelete} />
</AdminLayout>
