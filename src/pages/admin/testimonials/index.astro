---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import TestimonialsManager from '../../../components/admin/modules/TestimonialsManager.tsx';
import { PERMISSIONS } from '../../../lib/auth/permissions';
import { hasPermission } from '../../../lib/auth/rbac';

const session = Astro.locals.session!;
if (!hasPermission(session, PERMISSIONS.TESTIMONIALS_READ)) return Astro.redirect('/admin');
const canWrite = hasPermission(session, PERMISSIONS.TESTIMONIALS_WRITE);
const canDelete = hasPermission(session, PERMISSIONS.TESTIMONIALS_DELETE);
---

<AdminLayout title="Testimonials">
  <TestimonialsManager client:load canWrite={canWrite} canDelete={canDelete} />
</AdminLayout>
