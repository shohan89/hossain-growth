---
import { env } from 'cloudflare:workers';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import MediaImage from '../../components/ui/MediaImage.astro';
import { getDb } from '../../lib/db/client';
import { getPublishedBlogPosts, getMediaAssetsMap } from '../../lib/content/public';

export const prerender = false;

const categorySlug = Astro.url.searchParams.get('category') ?? undefined;
const db = getDb(env.DB);
const posts = await getPublishedBlogPosts(db, { categorySlug });
const mediaMap = await getMediaAssetsMap(
  db,
  posts.map((p) => p.featuredImageId),
);

// A category filter is the same template with a narrower result set, not
// distinct content — canonicalize every variant back to the base listing
// so search engines don't index a page per category as duplicate/thin
// content.
const canonicalUrl = new URL('/blog', Astro.url.origin).toString();
---

<SiteLayout
  title="Blog"
  description="Insights on digital marketing, SEO, paid media, and growth strategy from the Hossain Growth team."
  canonicalUrl={canonicalUrl}
>
  <section class="bg-ink-950 py-20 text-bone-50 lg:py-28">
    <Container class="flex flex-col gap-6">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} class="text-ink-400" />
      <h1 class="max-w-3xl font-display text-4xl font-bold sm:text-5xl lg:text-6xl">Insights.</h1>
      <p class="max-w-2xl text-lg text-ink-200">
        Practical thinking on marketing, SEO, and growth — from the team running these strategies
        every day.
      </p>
    </Container>
  </section>

  <section class="py-20 lg:py-28">
    <Container>
      {posts.length === 0 ? (
        <p class="text-ink-600">New articles are on the way — check back soon.</p>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="flex flex-col gap-3 rounded-3xl border border-ink-900/8 bg-bone-100 p-8 transition-colors hover:border-lime-500/60"
            >
              {post.featuredImageId && (
                <MediaImage
                  asset={mediaMap.get(post.featuredImageId)}
                  alt={post.title}
                  class="h-40 w-full rounded-2xl"
                  fallbackClass="hidden"
                />
              )}
              {post.categoryName && (
                <span class="text-xs font-semibold uppercase tracking-wide text-lime-600">
                  {post.categoryName}
                </span>
              )}
              <h2 class="font-display text-lg font-semibold text-ink-900">{post.title}</h2>
              <p class="text-sm text-ink-600">{post.excerpt}</p>
              <span class="mt-auto text-sm font-semibold text-ink-900">Read article →</span>
            </a>
          ))}
        </div>
      )}
    </Container>
  </section>
</SiteLayout>
