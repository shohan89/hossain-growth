---
import { env } from 'cloudflare:workers';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { getDb } from '../../lib/db/client';
import { getPublishedCaseStudies } from '../../lib/content/public';

const db = getDb(env.DB);
const caseStudies = await getPublishedCaseStudies(db);
---

<SiteLayout
  title="Case Studies"
  description="In-depth case studies showing the challenge, strategy, and results behind Hossain Growth client projects."
>
  <section class="bg-ink-950 py-20 text-bone-50 lg:py-28">
    <Container class="flex flex-col gap-6">
      <Breadcrumbs
        items={[{ label: 'Home', href: '/' }, { label: 'Case Studies' }]}
        class="text-ink-400"
      />
      <h1 class="max-w-3xl font-display text-4xl font-bold sm:text-5xl lg:text-6xl">
        Results, told in full.
      </h1>
      <p class="max-w-2xl text-lg text-ink-200">
        The challenge, the strategy, and the outcome — for every project we are able to share in
        detail.
      </p>
    </Container>
  </section>

  <section class="py-20 lg:py-28">
    <Container>
      {caseStudies.length === 0 ? (
        <p class="text-ink-600">New case studies are on the way — check back soon.</p>
      ) : (
        <div class="grid gap-5 lg:grid-cols-2">
          {caseStudies.map((study) => (
            <a
              href={`/case-studies/${study.slug}`}
              class="flex flex-col gap-4 rounded-3xl border border-ink-900/8 bg-bone-100 p-8 hover:border-lime-500/60"
            >
              <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-ink-400">
                {study.industry && <span>{study.industry}</span>}
                {study.client && <span>&middot; {study.client}</span>}
              </div>
              <h2 class="font-display text-xl font-semibold text-ink-900">{study.title}</h2>
              {study.results && <p class="text-sm text-ink-600">{study.results}</p>}
              <span class="mt-auto text-sm font-semibold text-ink-900">Read the full story →</span>
            </a>
          ))}
        </div>
      )}
    </Container>
  </section>

  <FinalCta />
</SiteLayout>
