---
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.tsx';
import { getDb } from '../lib/db/client';
import { getPublishedServices, getSiteSetting } from '../lib/content/public';

const db = getDb(env.DB);
const [services, contactEmail, contactPhone] = await Promise.all([
  getPublishedServices(db),
  getSiteSetting<string>(db, 'contact_email'),
  getSiteSetting<string>(db, 'contact_phone'),
]);
---

<SiteLayout
  title="Contact"
  description="Book a free consultation with Hossain Growth and get a clear view of where your growth strategy stands today."
>
  <section class="bg-ink-950 py-20 text-bone-50 lg:py-28">
    <Container class="flex flex-col gap-6">
      <Breadcrumbs
        items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
        class="text-ink-400"
      />
      <h1 class="max-w-3xl font-display text-4xl font-bold sm:text-5xl lg:text-6xl">
        Let's talk about growth.
      </h1>
      <p class="max-w-2xl text-lg text-ink-200">
        Book a free consultation and leave with a clear view of where your growth strategy stands
        today — no pressure, no generic pitch.
      </p>
    </Container>
  </section>

  <section class="py-20 lg:py-28">
    <Container class="grid gap-12 lg:grid-cols-[1fr_1.4fr]">
      <div class="flex flex-col gap-6">
        <h2 class="font-display text-2xl font-semibold text-ink-900">Get in touch</h2>
        <p class="text-ink-600">
          Fill out the form and a member of our team will respond within one business day.
        </p>
        {contactEmail && (
          <a href={`mailto:${contactEmail}`} class="font-semibold text-ink-900 hover:text-lime-600">
            {contactEmail}
          </a>
        )}
        {contactPhone && <p class="font-semibold text-ink-900">{contactPhone}</p>}
      </div>

      <ContactForm
        client:load
        turnstileSiteKey={env.TURNSTILE_SITE_KEY}
        services={services.map((service) => ({ slug: service.slug, title: service.title }))}
      />
    </Container>
  </section>
</SiteLayout>
