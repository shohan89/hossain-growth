---
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import TrustIndicators from '../components/home/TrustIndicators.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import FeaturedPortfolio from '../components/home/FeaturedPortfolio.astro';
import CaseStudyResults from '../components/home/CaseStudyResults.astro';
import GrowthProcess from '../components/home/GrowthProcess.astro';
import IndustriesStrip from '../components/home/IndustriesStrip.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Insights from '../components/home/Insights.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { getDb } from '../lib/db/client';
import {
  getPublishedServices,
  getPublishedPortfolioProjects,
  getPublishedCaseStudies,
  getPublishedBlogPosts,
  getPublishedTestimonials,
} from '../lib/content/public';

const db = getDb(env.DB);
const [services, portfolioProjects, caseStudies, blogPosts, testimonials] = await Promise.all([
  getPublishedServices(db),
  getPublishedPortfolioProjects(db, 3),
  getPublishedCaseStudies(db, 2),
  getPublishedBlogPosts(db, { limit: 3 }),
  getPublishedTestimonials(db, 3),
]);
---

<SiteLayout title="Hossain Growth">
  <Hero />
  <TrustIndicators />
  <ServicesOverview services={services} />
  <WhyChooseUs />
  <FeaturedPortfolio projects={portfolioProjects} />
  <CaseStudyResults caseStudies={caseStudies} />
  <GrowthProcess />
  <IndustriesStrip />
  <Testimonials testimonials={testimonials} />
  <Insights posts={blogPosts} />
  <FinalCta />
</SiteLayout>
