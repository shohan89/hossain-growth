---
import { env } from 'cloudflare:workers';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import Faq from '../../components/ui/Faq.astro';
import Icon from '../../components/ui/Icon.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { getDb } from '../../lib/db/client';
import { getServiceBySlug, getCaseStudiesForService } from '../../lib/content/public';
import { SERVICE_DETAILS, SERVICE_ICON } from '../../content/services-detail';
import { serviceSchema } from '../../lib/seo';

export const prerender = false;

const { slug } = Astro.params;
const db = getDb(env.DB);
const service = slug ? await getServiceBySlug(db, slug) : null;

if (!service) {
  return new Response('Service not found', { status: 404 });
}

const detail = SERVICE_DETAILS[service.slug];
const caseStudies = await getCaseStudiesForService(db, service.id);
const canonicalUrl = new URL(`/services/${service.slug}`, Astro.url.origin).toString();
---

<SiteLayout
  title={service.title}
  description={service.summary ?? undefined}
  canonicalUrl={canonicalUrl}
  structuredData={serviceSchema({
    name: service.title,
    description: service.summary ?? undefined,
    url: canonicalUrl,
  })}
>
  <section class="bg-ink-950 py-20 text-bone-50 lg:py-28">
    <Container class="flex flex-col gap-6">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Services', href: '/services' },
          { label: service.title },
        ]}
        class="text-ink-400"
      />
      <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-lime-400 text-ink-950">
        <Icon name={SERVICE_ICON[service.slug] ?? 'layers'} class="h-6 w-6" />
      </span>
      <h1 class="max-w-3xl font-display text-4xl font-bold sm:text-5xl lg:text-6xl">
        {detail?.heroHeadline ?? service.title}
      </h1>
      <p class="max-w-2xl text-lg text-ink-200">{detail?.heroSubheadline ?? service.summary}</p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <Button href="/contact" variant="primary" size="lg">
          Book a Free Consultation
        </Button>
        <Button
          href="/portfolio"
          variant="outline"
          size="lg"
          class="border-bone-50/20 text-bone-50 hover:border-bone-50/50"
        >
          See our work
        </Button>
      </div>
    </Container>
  </section>

  {detail && (
    <section class="py-20 lg:py-28">
      <Container class="grid gap-10 lg:grid-cols-2">
        <div class="flex flex-col gap-4">
          <span class="text-sm font-semibold uppercase tracking-wide text-ink-400">
            The problem
          </span>
          <p class="text-lg text-ink-800">{detail.problem}</p>
        </div>
        <div class="flex flex-col gap-4">
          <span class="text-sm font-semibold uppercase tracking-wide text-lime-600">
            Our approach
          </span>
          <p class="text-lg text-ink-800">{detail.solution}</p>
        </div>
      </Container>
    </section>
  )}

  {detail && (
    <section class="bg-bone-100 py-20 lg:py-28">
      <Container class="flex flex-col gap-12">
        <SectionHeading eyebrow="Benefits" title="What you get" />
        <div class="grid gap-5 sm:grid-cols-2">
          {detail.benefits.map((benefit) => (
            <div class="rounded-3xl border border-ink-900/8 bg-bone-50 p-8">
              <h3 class="font-display text-lg font-semibold text-ink-900">{benefit.title}</h3>
              <p class="mt-2 text-sm text-ink-600">{benefit.description}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}

  {detail && (
    <section class="py-20 lg:py-28">
      <Container class="flex flex-col gap-12">
        <SectionHeading eyebrow="Our process" title="How we run this service" />
        <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {detail.process.map((step, index) => (
            <li class="flex flex-col gap-3 rounded-3xl border border-ink-900/8 p-6">
              <span class="font-display text-2xl font-bold text-lime-500">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="font-display text-base font-semibold text-ink-900">{step.title}</h3>
              <p class="text-sm text-ink-600">{step.description}</p>
            </li>
          ))}
        </ol>
      </Container>
    </section>
  )}

  {detail && (
    <section class="bg-ink-950 py-20 text-bone-50 lg:py-28">
      <Container class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
        <SectionHeading
          eyebrow="Deliverables"
          title="What's included"
          tone="dark"
          class="lg:max-w-sm"
        />
        <ul class="flex flex-1 flex-col gap-3">
          {detail.deliverables.map((item) => (
            <li class="flex items-start gap-3 rounded-2xl border border-bone-50/10 bg-bone-50/5 p-4 text-sm text-ink-200">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-lime-400" aria-hidden="true" />
              {item}
            </li>
          ))}
        </ul>
      </Container>
    </section>
  )}

  {caseStudies.length > 0 && (
    <section class="py-20 lg:py-28">
      <Container class="flex flex-col gap-12">
        <SectionHeading eyebrow="Proof it works" title="Related case studies" />
        <div class="grid gap-5 lg:grid-cols-2">
          {caseStudies.map((study) => (
            <a
              href={`/case-studies/${study.slug}`}
              class="flex flex-col gap-3 rounded-3xl border border-ink-900/8 bg-bone-100 p-8 hover:border-lime-500/60"
            >
              <h3 class="font-display text-lg font-semibold text-ink-900">{study.title}</h3>
              {study.results && <p class="text-sm text-ink-600">{study.results}</p>}
              <span class="mt-auto text-sm font-semibold text-ink-900">Read the full story →</span>
            </a>
          ))}
        </div>
      </Container>
    </section>
  )}

  {detail && (
    <section class="bg-bone-100 py-20 lg:py-28">
      <Container class="max-w-3xl">
        <SectionHeading eyebrow="FAQs" title="Common questions" class="mb-10" />
        <Faq items={detail.faqs} />
      </Container>
    </section>
  )}

  <FinalCta
    title={`Ready to put ${service.title} to work for your business?`}
    description="Book a free consultation and we will map out exactly where to start."
  />
</SiteLayout>
