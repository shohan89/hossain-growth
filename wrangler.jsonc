{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hossain-growth",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  // No top-level "main" here: the Astro Cloudflare adapter's build pipeline
  // (astro dev / astro build / astro check) resolves this file itself and
  // requires "main" to already point at an existing file at config-resolution
  // time — which is impossible before the first build has run. The adapter
  // generates its own dist/server/wrangler.json with the correct "main" and
  // "assets" paths after each build; use that for `wrangler dev`/`deploy`
  // against the built output (see package.json "preview"/"deploy:*" scripts).
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },

  // Default (development) bindings — used by `wrangler dev` / `npm run preview`.
  // These point at real dev-tier Cloudflare resources created for local work.
  // NEVER point these at production resources.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hossain-growth-dev",
      "database_id": "fb83d37f-8d99-40a3-b5f6-b2852b5e3643",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "hossain-growth-media-dev",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "5369f2d115f44557993fa6bfbe04801b",
    },
    {
      "binding": "CACHE",
      "id": "4c62b0e08217426ebafcc89c09a6f096",
    },
  ],
  "vars": {
    "SITE_URL": "http://localhost:4321",
    "ENVIRONMENT": "development",
    "EMAIL_PROVIDER": "none",
    "EMAIL_FROM": "no-reply@hossaingrowth.local",
    "NOTIFICATION_EMAIL_TO": "dev-admin@hossaingrowth.local",
  },

  "env": {
    "staging": {
      "name": "hossain-growth-staging",
      "vars": {
        "SITE_URL": "https://staging.hossaingrowth.com",
        "ENVIRONMENT": "staging",
        "EMAIL_PROVIDER": "none",
        "EMAIL_FROM": "no-reply@staging.hossaingrowth.com",
        "NOTIFICATION_EMAIL_TO": "REPLACE_WITH_STAGING_NOTIFICATION_EMAIL",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hossain-growth-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "hossain-growth-media-staging",
        },
      ],
      "kv_namespaces": [
        { "binding": "SESSIONS", "id": "REPLACE_WITH_STAGING_SESSIONS_KV_ID" },
        { "binding": "CACHE", "id": "REPLACE_WITH_STAGING_CACHE_KV_ID" },
      ],
    },

    "production": {
      "name": "hossain-growth-production",
      "vars": {
        // Real workers.dev URL, confirmed from first deploy output
        // (no custom domain yet — launching on workers.dev per explicit
        // instruction). See docs/DEPLOYMENT_GUIDE.md §5.
        "SITE_URL": "https://hossain-growth-production.maffin-killer007.workers.dev",
        "ENVIRONMENT": "production",
        // No real Resend API key available yet — "none" is the documented
        // safe default (Phase 7 design: lead creation never depends on
        // this). Switch to "resend" + `wrangler secret put EMAIL_API_KEY`
        // once a real key exists; no other change needed.
        "EMAIL_PROVIDER": "none",
        "EMAIL_FROM": "no-reply@hossaingrowth.com",
        "NOTIFICATION_EMAIL_TO": "",
        // Real managed widget, created against the real workers.dev
        // hostname after first deploy. See docs/DEPLOYMENT_GUIDE.md §4.2.
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGM5ZrD0lQQhJ0Qe",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hossain-growth-production",
          "database_id": "a04eb744-fdfd-4163-a498-0e5e85527ddc",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "hossain-growth-media-production",
        },
      ],
      "kv_namespaces": [
        { "binding": "SESSIONS", "id": "2265c8f3a8834ba59ca5d21152052186" },
        { "binding": "CACHE", "id": "5a98d937e37b4cc2b3dcd0362af2baeb" },
      ],
    },
  },
}
